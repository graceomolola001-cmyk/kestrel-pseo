      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const report = $input.first().json;\nif (!report || typeof report !== 'object') throw new Error('The HTTP response is not a JSON audit');\nif (!report.counts || !Number.isFinite(Number(report.counts.error))) {\n  throw new Error('Missing expected audit counts: check the published report URL');\n}\nconst errors = Number(report.counts.error);\nconst warnings = Number(report.counts.warning || 0);\nconst pagesChecked = Number(report.pages_checked || 0);\nreturn [{\n  json: {\n    project: 'Kestrel SEO Operations Lab',\n    source: 'Published GitHub Pages audit',\n    audited_at: report.created_at || 'unknown',\n    audited_url: report.target || '',\n    pages_checked: pagesChecked,\n    errors,\n    warnings,\n    requires_attention: errors > 0,\n    recommendation: errors > 0\n      ? 'Review the reported URLs and investigate before release.'\n      : 'No critical issues in checked scope. Verify coverage separately.',\n    issue_sample: (report.findings || []).filter(x => x.severity === 'error').slice(0, 5)\n  }\n}];"
      }
    },
